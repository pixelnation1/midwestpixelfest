# Public site
# NEXT_PUBLIC_SITE_URL=https://midwestpixelfest.com
# NEXT_PUBLIC_CONTACT_EMAIL=hello@midwestpixelfest.com

# Resend — server-only. Never prefix with NEXT_PUBLIC_.
# Required in production for inquiry email delivery.
RESEND_API_KEY=

# Optional verified From override. Default:
# Midwest Pixel Fest <website@midwestpixelfest.com>
# FORM_FROM_EMAIL=

# Optional notification inbox override. Default:
# hello@midwestpixelfest.com
# CONTACT_NOTIFICATION_EMAIL=

# Optional JSON webhook used only when Resend is not configured.
# FORM_WEBHOOK_URL=
# Optional bearer token for FORM_WEBHOOK_URL.
# EMAIL_PROVIDER_API_KEY=

# Set to true only if the webhook should also run when Resend is configured.
# FORM_WEBHOOK_WITH_RESEND=

# Newsletter list signup is separate from operational email.
# NEWSLETTER_WEBHOOK_URL=

# Optional GA4 and Search Console.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GOOGLE_SITE_VERIFICATION=

# Supabase — organizer persistence and authentication.
# NEXT_PUBLIC_ values are browser-visible. Never put the service role here.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Never import into Client Components.
# SUPABASE_SERVICE_ROLE_KEY=
