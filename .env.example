# Production site: https://midwestpixelfest.com
#
# Copy to .env.local for development. Never commit real secrets.
# Never prefix secret keys with NEXT_PUBLIC_.

# Public site origin. Used for canonical URLs, sitemap, and Open Graph.
# Public. Optional locally (defaults to https://midwestpixelfest.com). Set in production.
NEXT_PUBLIC_SITE_URL=https://midwestpixelfest.com

# Public business inbox shown on /contact and /privacy. Not used to send mail.
# Public. Optional. Do not put a personal address here.
NEXT_PUBLIC_CONTACT_EMAIL=

# Resend transactional email (server-only). Required together for operational form notifications:
# contact, vendor_interest, sponsor_inquiry, volunteer_interest, guest_inquiry, press_inquiry.
# Newsletter signups are NOT sent through Resend.
RESEND_API_KEY=
FORM_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Newsletter list provider webhook (server-only). Required for newsletter signups to succeed.
# POST JSON: { "email", "consent", "submittedAt" } plus firstName when provided.
NEWSLETTER_WEBHOOK_URL=

# Optional JSON webhook for operational forms (in addition to or instead of Resend).
# Server-only. Production must be https. Local development may use http.
FORM_WEBHOOK_URL=

# Optional bearer token sent as Authorization: Bearer <key> to FORM_WEBHOOK_URL.
# Server-only. Never prefix with NEXT_PUBLIC_.
EMAIL_PROVIDER_API_KEY=

# Google Search Console HTML-tag verification (content= value only, not the full meta tag).
# Server-only. Optional until Search Console is connected.
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXX). Public. Optional.
# Scripts load only when this is set. Do not invent an ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
